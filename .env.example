# Copy to .env.local and fill in. NEVER put real values in this file: it is committed.

# Sanity (create a project at https://sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token, only needed locally to run `npm run seed`. Do not add to Netlify.
SANITY_API_WRITE_TOKEN=
# Same secret you set on the Sanity webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=

# Contact form (Gmail SMTP). Use a Google "App password", not your login password:
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where messages are delivered (defaults to GMAIL_USER)
CONTACT_TO_EMAIL=

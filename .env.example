# Sanity (create a project at https://sanity.io/manage, then fill these in)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token, only needed to run `npm run seed`
SANITY_API_WRITE_TOKEN=
# Same secret you set on the Sanity webhook -> /api/revalidate
SANITY_REVALIDATE_SECRET=

# Contact form (Gmail SMTP). Use a Google "App password", not your login password:
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where messages are delivered (defaults to GMAIL_USER)
CONTACT_TO_EMAIL=
